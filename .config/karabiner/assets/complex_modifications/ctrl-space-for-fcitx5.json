{
    "title": "ctrl-space to ctrl-shift-h (ctrl-space to switch fcitx5 im state does not work in Terminal.app; c-s-h does not work in fltk, so do not change globally)",
    "rules": [
        {
            "description": "ctrl-space to ctrl-shift-h (Terminal.app; for fcitx5)",
            "manipulators": [
                {
                    "conditions": [
                        {
                            "bundle_identifiers": [
                                "^com.apple.Terminal$"
                            ],
                            "type": "frontmost_application_if"
                        }
                    ],
                    "from": {
                        "key_code": "spacebar",
                        "modifiers": {
                            "mandatory": [
                                "control"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "h",
                            "modifiers": [
                                "left_shift",
                                "left_control"
                            ]
                        }
                    ],
                    "type": "basic"
                }
            ]
        }
    ]
}
