{
    "title": "macos Terminal.app",
    "description": "Change some keys for macos Terminal.app",
    "rules": [
        {
            "description": "Change command to option when some of a-z key is pressed (macos Terminal.app)",
            "manipulators": [
                {
                    "conditions": [
                        {
                            "bundle_identifiers": [
                                "^com.apple.Terminal$"
                            ],
                            "type": "frontmost_application_if"
                        }
                    ],
                    "from": {
                        "key_code": "left_command"
                    },
                    "to": [
                        {
                            "key_code": "left_command"
                        }
                    ],
                    "to_if_other_key_pressed": [
                        {
                            "other_keys": [
                                { "key_code": "e", "modifiers": {"optional": ["command"]} },
                                { "key_code": "h", "modifiers": {"optional": ["command"]} },
                                { "key_code": "j", "modifiers": {"optional": ["command"]} },
                                { "key_code": "k", "modifiers": {"optional": ["command"]} },
                                { "key_code": "l", "modifiers": {"optional": ["command"]} },
                                { "key_code": "n", "modifiers": {"optional": ["command"]} },
                                { "key_code": "o", "modifiers": {"optional": ["command"]} },
                                { "key_code": "p", "modifiers": {"optional": ["command"]} }
                            ],
                            "to": [
                                {
                                    "key_code": "left_option",
                                    "modifiers": []
                                }
                            ]
                        }
                    ],
                    "type": "basic"
                }
            ]
        },
        {
            "description": "Change ctrl+shift+n to open new window (macos Terminal.app)",
            "manipulators": [
                {
                    "conditions": [
                        {
                            "bundle_identifiers": [
                                "^com.apple.Terminal$"
                            ],
                            "type": "frontmost_application_if"
                        }
                    ],
                    "from": {
                        "key_code": "n",
                        "modifiers": {
                            "mandatory": [
                                "control",
                                "shift"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "n",
                            "modifiers": [
                                "command"
                            ]
                        }
                    ],
                    "type": "basic"
                }
            ]
        }
    ]
}
